<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WAMFF.Components.FileDisplayColletion"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WAMFF.Components"
    xmlns:viewmodels="using:WAMFF.Core.ViewModels"
    xmlns:components="using:WAMFF.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    d:DataContext="{d:DesignInstance Type=components:FileDisplayColletion}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <viewmodels:FileDisplayCollectionViewModel x:Name="ViewModel" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Height="45" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="30" />
                <ColumnDefinition x:Name="NameColumn" Width="*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="85" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition x:Name="TypeColumn" Width="200" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="13" />
            </Grid.ColumnDefinitions>
            
            <Button Grid.Column="2" Command="{x:Bind ViewModel.Sorter.SortByNameCommand}" Padding="5 0" Margin="10 0 10 0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Name" VerticalAlignment="Center" Margin="0 0 5 0" />
                    <FontIcon Glyph="{x:Bind ViewModel.Sorter.NameIcon, Mode=OneWay}" FontSize="15" />
                </StackPanel>
            </Button>

            <AppBarSeparator Grid.Column="3" />

            <Button Grid.Column="4" Command="{x:Bind ViewModel.Sorter.SortByCategoryCommand}" Padding="5 0" Margin="10 0 10 0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Category" VerticalAlignment="Center" Margin="0 0 5 0" />
                    <FontIcon Glyph="{x:Bind ViewModel.Sorter.CategoryIcon, Mode=OneWay}" FontSize="15" />
                </StackPanel>
            </Button>

            <AppBarSeparator Grid.Column="5" />

            <Button Grid.Column="6" Command="{x:Bind ViewModel.Sorter.SortByTagsCommand}" Padding="5 0" Margin="10 0 10 0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Tags" VerticalAlignment="Center" Margin="0 0 5 0" />
                    <FontIcon Glyph="{x:Bind ViewModel.Sorter.TagsIcon, Mode=OneWay}" FontSize="15" />
                </StackPanel>
            </Button>

            <AppBarSeparator Grid.Column="7" />

            <Button Grid.Column="8" Command="{x:Bind ViewModel.Sorter.SortByTypeCommand}" Padding="5 0" Margin="10 0 10 0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Type" VerticalAlignment="Center" Margin="0 0 5 0" />
                    <FontIcon Glyph="{x:Bind ViewModel.Sorter.TypeIcon, Mode=OneWay}" FontSize="15" />
                </StackPanel>
            </Button>
            
            <AppBarSeparator Grid.Column="9" />

            <Button Grid.Column="10" Command="{x:Bind ViewModel.Sorter.SortByExtensionCommand}" Padding="5 0" Margin="10 0 10 0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Ext" VerticalAlignment="Center" Margin="0 0 5 0" />
                    <FontIcon Glyph="{x:Bind ViewModel.Sorter.ExtensionIcon, Mode=OneWay}" FontSize="15" />
                </StackPanel>
            </Button>

            <AppBarSeparator Grid.Column="11" />

            <Button Grid.Column="12" Command="{x:Bind ViewModel.Sorter.SortByCreatedDateCommand}" Padding="5 0" Margin="10 0 10 0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Created date" VerticalAlignment="Center" Margin="0 0 5 0" />
                    <FontIcon Glyph="{x:Bind ViewModel.Sorter.CreatedDateIcon, Mode=OneWay}" FontSize="15" />
                </StackPanel>
            </Button>
            

            <AppBarSeparator Grid.Column="13" />

            <Button Grid.Column="14" Command="{x:Bind ViewModel.Sorter.SortByLastModifiedDateCommand}" Padding="5 0" Margin="10 0 10 0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Last modified" VerticalAlignment="Center" Margin="0 0 5 0" />
                    <FontIcon Glyph="{x:Bind ViewModel.Sorter.LastModifiedDateIcon, Mode=OneWay}" FontSize="15" />
                </StackPanel>
            </Button>

            <AppBarSeparator Grid.Column="15" />

            <Button Grid.Column="16" Command="{x:Bind ViewModel.Sorter.SortBySizeCommand}" Padding="5 0" Margin="10 0 10 0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent">
                <StackPanel Orientation="Horizontal" >
                    <TextBlock Text="Size" VerticalAlignment="Center" Margin="0 0 5 0" />
                    <FontIcon Glyph="{x:Bind ViewModel.Sorter.SizeIcon, Mode=OneWay}" FontSize="15" />
                </StackPanel>
            </Button>
        </Grid>

        <ListView ItemsSource="{x:Bind ViewModel.FileDisplayViewModels}"  Grid.Row="1">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:FileDisplayViewModel">
                    <components:FileDisplay ViewModel="{x:Bind}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>