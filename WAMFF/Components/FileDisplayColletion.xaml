<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WAMFF.Components.FileDisplayColletion"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WAMFF.Components"
    xmlns:viewmodels="using:WAMFF.Core.ViewModels"
    xmlns:components="using:WAMFF.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <viewmodels:FileDisplayCollectionViewModel x:Name="ViewModel" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Height="45" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="45" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="13" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="2" Text="Name" VerticalAlignment="Center" Margin="10 0 0 0" />

            <AppBarSeparator Grid.Column="3" />
            <TextBlock Grid.Column="4" Text="Category" VerticalAlignment="Center" Margin="10 0 0 0" />

            <AppBarSeparator Grid.Column="5" />
            <TextBlock Grid.Column="6" Text="Tags" VerticalAlignment="Center" Margin="10 0 0 0" />

            <AppBarSeparator Grid.Column="7" />
            <TextBlock Grid.Column="8" Text="Type" VerticalAlignment="Center" Margin="10 0 0 0" />

            <AppBarSeparator Grid.Column="9" />
            <TextBlock Grid.Column="10" Text="Extension" VerticalAlignment="Center" Margin="10 0 0 0" />

            <AppBarSeparator Grid.Column="11" />
            <TextBlock Grid.Column="12" Text="Created date" VerticalAlignment="Center" Margin="10 0 0 0" />

            <AppBarSeparator Grid.Column="13" />
            <TextBlock Grid.Column="14" Text="Last modified" VerticalAlignment="Center" Margin="10 0 0 0" />

            <AppBarSeparator Grid.Column="15" />
            <TextBlock Grid.Column="16" Text="Size" VerticalAlignment="Center" Margin="10 0 0 0" />
        </Grid>

        <ListView ItemsSource="{x:Bind ViewModel.FileDisplayViewModels}"  Grid.Row="1">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:FileDisplayViewModel">
                    <components:FileDisplay ViewModel="{x:Bind}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>